; lib/evolve.aura — Spec-driven agent search (issue #24 / M4)
;
; (require "evolve" all:)
;
; Aether O→D→M→V→R on a named spec (DC voltage or .tran .measure).
; Hill-climb or scale-toward-target. Every commit is a good snapshot
; the caller can restore. The mutation log is replayable.

(export daed:evolve-version
        daed:spec-v
        daed:spec-when
        daed:spec-risetime
        daed:spec-final
        daed:eval-spec
        daed:spec-ok?
        daed:spec-pass?
        daed:spec-err
        daed:spec-value
        daed:evo-try!
        daed:evolve
        daed:evo-ok?
        daed:evo-reached?
        daed:evo-steps
        daed:evo-value
        daed:evo-err
        daed:evo-log
        daed:evo-n-good
        daed:evo-good
        daed:evo-restore-good!
        daed:evo-replay!)

(require "netlist" all:)
(require "solve" all:)
(require "tran" all:)
(require "probe" all:)
(require "measure" all:)
(require "mutate-circuit" all:)

(define daed:evolve-version 1)

(define (daed:spec-v node target tol)
  (let ((h (hash)))
    (hash-set! h "kind" "v")
    (hash-set! h "node" node)
    (hash-set! h "target" target)
    (hash-set! h "tol" tol)
    h))

(define (daed:spec-when node thresh t-target tol dt nsteps)
  (let ((h (hash)))
    (hash-set! h "kind" "when")
    (hash-set! h "node" node)
    (hash-set! h "thresh" thresh)
    (hash-set! h "target" t-target)
    (hash-set! h "tol" tol)
    (hash-set! h "dt" dt)
    (hash-set! h "nsteps" nsteps)
    h))

(define (daed:spec-risetime node target tol dt nsteps)
  (let ((h (hash)))
    (hash-set! h "kind" "risetime")
    (hash-set! h "node" node)
    (hash-set! h "target" target)
    (hash-set! h "tol" tol)
    (hash-set! h "dt" dt)
    (hash-set! h "nsteps" nsteps)
    h))

(define (daed:spec-final node target tol dt nsteps)
  (let ((h (hash)))
    (hash-set! h "kind" "final")
    (hash-set! h "node" node)
    (hash-set! h "target" target)
    (hash-set! h "tol" tol)
    (hash-set! h "dt" dt)
    (hash-set! h "nsteps" nsteps)
    h))

(define (daed:spec-fail)
  (let ((h (hash)))
    (hash-set! h "ok" #f)
    (hash-set! h "pass" #f)
    (hash-set! h "err" 1e300)
    (hash-set! h "value" 0.0)
    h))

(define (daed:eval-spec ckt spec)
  (if (not spec)
    (daed:spec-fail)
    (let ((kind (hash-ref spec "kind" "v"))
          (node (hash-ref spec "node" 0))
          (target (hash-ref spec "target" 0.0))
          (tol (hash-ref spec "tol" 0.0)))
      (if (equal? kind "v")
        (let ((op (daed:simulate-op ckt)))
          (if (not (daed:op-ok? op))
            (daed:spec-fail)
            (let ((val (daed:v op node))
                  (h (hash)))
              (hash-set! h "ok" #t)
              (hash-set! h "value" val)
              (hash-set! h "err" (abs (- val target)))
              (hash-set! h "pass" (< (abs (- val target)) tol))
              h)))
        (let ((dt (hash-ref spec "dt" 1e-5))
              (ns (hash-ref spec "nsteps" 100)))
          (let ((tr (daed:simulate-tran ckt dt ns)))
            (if (not (daed:tran-ok? tr))
              (daed:spec-fail)
              (let ((m #f)
                    (val 0.0))
                (if (equal? kind "when")
                  (begin
                    (set! m (daed:measure-when tr node
                                               (hash-ref spec "thresh" 0.0)))
                    (if (daed:meas-ok? m)
                      (set! val (daed:meas-t m))
                      (set! m #f)))
                  0)
                (if (equal? kind "risetime")
                  (begin
                    (set! m (daed:measure-risetime tr node))
                    (if (daed:meas-ok? m)
                      (set! val (daed:meas-value m))
                      (set! m #f)))
                  0)
                (if (equal? kind "final")
                  (begin
                    (set! m (daed:measure-final tr node))
                    (if (daed:meas-ok? m)
                      (set! val (daed:meas-value m))
                      (set! m #f)))
                  0)
                (if (not m)
                  (daed:spec-fail)
                  (let ((h (hash)))
                    (hash-set! h "ok" #t)
                    (hash-set! h "value" val)
                    (hash-set! h "err" (abs (- val target)))
                    (hash-set! h "pass" (< (abs (- val target)) tol))
                    h))))))))))

(define (daed:spec-ok? e)
  (hash-ref e "ok" #f))

(define (daed:spec-pass? e)
  (hash-ref e "pass" #f))

(define (daed:spec-err e)
  (hash-ref e "err" 1e300))

(define (daed:spec-value e)
  (hash-ref e "value" 0.0))

; One O→D→M→V→R attempt against a spec. Leaves a commit in place.
(define (daed:evo-try! ckt spec name new-value)
  (let ((res (hash))
        (done #f))
    (hash-set! res "name" name)
    (hash-set! res "new" new-value)
    (hash-set! res "ok" #f)
    (hash-set! res "decision" "refuse")
    (hash-set! res "reason" "init")
    (hash-set! res "old" 0.0)
    (hash-set! res "e0" 1e300)
    (hash-set! res "e1" 1e300)
    (hash-set! res "value" 0.0)
    (hash-set! res "pass" #f)
    (let ((e0 (daed:eval-spec ckt spec)))
      (if (not (daed:spec-ok? e0))
        (begin
          (hash-set! res "reason" "observe-failed")
          (set! done #t))
        (begin
          (hash-set! res "e0" (daed:spec-err e0))
          (hash-set! res "value" (daed:spec-value e0))
          (hash-set! res "pass" (daed:spec-pass? e0))
          (if (daed:spec-pass? e0)
            (begin
              (hash-set! res "ok" #t)
              (hash-set! res "decision" "skip")
              (hash-set! res "reason" "within-tol")
              (hash-set! res "e1" (daed:spec-err e0))
              (set! done #t))
            0))))
    (if (not done)
      (let ((c (daed:find-comp ckt name)))
        (if (not c)
          (begin
            (hash-set! res "reason" "not-found")
            (set! done #t))
          (let ((old (daed:comp-value c))
                (snap (daed:circuit-snapshot ckt)))
            (hash-set! res "old" old)
            (let ((mut (daed:mutate-value! ckt name new-value)))
              (if (not (hash-ref mut "ok" #f))
                (begin
                  (hash-set! res "decision" "refuse")
                  (hash-set! res "reason" (hash-ref mut "reason" "bad-value"))
                  (set! done #t))
                (let ((e1 (daed:eval-spec ckt spec)))
                  (if (not (daed:spec-ok? e1))
                    (begin
                      (daed:restore-circuit! ckt snap)
                      (hash-set! res "decision" "rollback")
                      (hash-set! res "reason" "observe-after-failed")
                      (set! done #t))
                    (begin
                      (hash-set! res "e1" (daed:spec-err e1))
                      (hash-set! res "value" (daed:spec-value e1))
                      (hash-set! res "pass" (daed:spec-pass? e1))
                      (if (or (daed:spec-pass? e1)
                              (< (daed:spec-err e1) (hash-ref res "e0" 1e300)))
                        (begin
                          (hash-set! res "ok" #t)
                          (hash-set! res "decision" "commit")
                          (if (daed:spec-pass? e1)
                            (hash-set! res "reason" "within-tol")
                            (hash-set! res "reason" "improved"))
                          (set! done #t))
                        (begin
                          (daed:restore-circuit! ckt snap)
                          (hash-set! res "decision" "rollback")
                          (hash-set! res "reason" "verify-worsened")
                          (set! done #t)))))))))))
      0)
    res))

(define (daed:list-n xs)
  (let ((n 0))
    (let loop ((ys xs))
      (if (null? ys)
        n
        (begin
          (set! n (+ n 1))
          (loop (cdr ys)))))))

(define (daed:rev->vec xs)
  (let ((n (daed:list-n xs))
        (p xs))
    (let ((v (make-vector n 0.0))
          (i (- n 1)))
      (while (lambda () (>= i 0))
        (lambda ()
          (vector-set! v i (car p))
          (set! p (cdr p))
          (set! i (- i 1))))
      v)))

(define (daed:evo-clamp-fac fac)
  (let ((f fac))
    (if (< f 0.3) (set! f 0.3) 0)
    (if (> f 3.0) (set! f 3.0) 0)
    (if (and (> f 0.97) (< f 1.03))
      (if (> f 1.0) (set! f 1.08) (set! f 0.92))
      0)
    f))

(define (daed:evolve ckt spec name max-steps strategy)
  (let ((res (hash))
        (lim (daed:as-int max-steps))
        (steps 0)
        (reached #f)
        (fac 0.7)
        (flipped 0)
        (logacc '())
        (goodacc '())
        (n-good 0)
        (strat (if (string? strategy) strategy "hill"))
        (last #f))
    (if (< lim 1)
      (set! lim 1)
      0)
    (hash-set! res "name" name)
    (hash-set! res "strategy" strat)
    (let ((e0 (daed:eval-spec ckt spec)))
      (if (and (daed:spec-ok? e0) (daed:spec-pass? e0))
        (begin
          (set! reached #t)
          (let ((h (hash)))
            (hash-set! h "name" name)
            (hash-set! h "decision" "skip")
            (hash-set! h "reason" "within-tol")
            (hash-set! h "ok" #t)
            (hash-set! h "old" 0.0)
            (hash-set! h "new" 0.0)
            (hash-set! h "e0" (daed:spec-err e0))
            (hash-set! h "e1" (daed:spec-err e0))
            (hash-set! h "value" (daed:spec-value e0))
            (hash-set! h "pass" #t)
            (set! last h)
            (set! logacc (cons h logacc))))
        0))
    (while (lambda () (and (not reached) (< steps lim)))
      (lambda ()
        (let ((c (daed:find-comp ckt name))
              (ev (daed:eval-spec ckt spec))
              (prop #f))
          (if (and (daed:spec-ok? ev) (daed:spec-pass? ev))
            (set! reached #t)
            (if (not c)
              (begin
                (set! last
                  (let ((h (hash)))
                    (hash-set! h "decision" "refuse")
                    (hash-set! h "reason" "not-found")
                    (hash-set! h "ok" #f)
                    h))
                (set! logacc (cons last logacc))
                (set! steps lim))
              (begin
                (if (equal? strat "scale")
                  (let ((val (daed:spec-value ev))
                        (tgt (hash-ref spec "target" 0.0))
                        (old (daed:comp-value c)))
                    (if (or (not (number? val)) (not (number? tgt))
                            (= val 0.0) (<= old 0.0))
                      (set! prop #f)
                      (set! prop (* old (/ tgt val)))))
                  (set! prop (* (daed:comp-value c) fac)))
                (if (not (and (number? prop) (> prop 0.0) (< prop 1e12)))
                  (begin
                    (set! last
                      (let ((h (hash)))
                        (hash-set! h "decision" "refuse")
                        (hash-set! h "reason" "no-proposal")
                        (hash-set! h "ok" #f)
                        h))
                    (set! logacc (cons last logacc))
                    (set! fac (daed:evo-clamp-fac (/ 1.0 fac)))
                    (set! steps (+ steps 1)))
                  (begin
                    (set! last (daed:evo-try! ckt spec name prop))
                    (set! logacc (cons last logacc))
                    (set! steps (+ steps 1))
                    (if (equal? (hash-ref last "decision" "") "skip")
                      (set! reached #t)
                      0)
                    (if (equal? (hash-ref last "decision" "") "commit")
                      (begin
                        (set! n-good (+ n-good 1))
                        (let ((gh (hash)))
                          (hash-set! gh "i" steps)
                          (hash-set! gh "err" (hash-ref last "e1" 1e300))
                          (hash-set! gh "value" (hash-ref last "value" 0.0))
                          (hash-set! gh "name" name)
                          (hash-set! gh "param" (hash-ref last "new" 0.0))
                          (hash-set! gh "snap" (daed:circuit-snapshot ckt))
                          (set! goodacc (cons gh goodacc)))
                        (set! flipped 0)
                        (if (hash-ref last "pass" #f)
                          (set! reached #t)
                          0))
                      0)
                    (if (equal? (hash-ref last "decision" "") "rollback")
                      (begin
                        (set! fac (daed:evo-clamp-fac (/ 1.0 fac)))
                        (set! flipped (+ flipped 1))
                        (if (>= flipped 2)
                          (begin
                            (if (> fac 1.0)
                              (set! fac (daed:evo-clamp-fac (+ 1.0 (* 0.5 (- fac 1.0)))))
                              (set! fac (daed:evo-clamp-fac (- 1.0 (* 0.5 (- 1.0 fac))))))
                            (set! flipped 0))
                          0))
                      0)
                    (if (equal? (hash-ref last "decision" "") "refuse")
                      (begin
                        (set! fac (daed:evo-clamp-fac (/ 1.0 fac)))
                        (if (equal? strat "scale")
                          (set! steps lim)
                          0))
                      0)))))))))
    (let ((ef (daed:eval-spec ckt spec)))
      (hash-set! res "ok" (and (daed:spec-ok? ef) (daed:spec-pass? ef)))
      (hash-set! res "reached" (hash-ref res "ok" #f))
      (hash-set! res "steps" steps)
      (hash-set! res "value" (daed:spec-value ef))
      (hash-set! res "err" (daed:spec-err ef))
      (hash-set! res "last" last)
      (hash-set! res "n_good" n-good)
      (hash-set! res "log" (daed:rev->vec logacc))
      (hash-set! res "goods" (daed:rev->vec goodacc))
      res)))

(define (daed:evo-ok? r)
  (hash-ref r "ok" #f))

(define (daed:evo-reached? r)
  (hash-ref r "reached" #f))

(define (daed:evo-steps r)
  (hash-ref r "steps" 0))

(define (daed:evo-value r)
  (hash-ref r "value" 0.0))

(define (daed:evo-err r)
  (hash-ref r "err" 1e300))

(define (daed:evo-log r)
  (hash-ref r "log" (make-vector 0 #f)))

(define (daed:evo-n-good r)
  (hash-ref r "n_good" 0))

(define (daed:evo-good r k)
  (let ((gv (hash-ref r "goods" (make-vector 0 #f))))
    (if (and (number? k) (>= k 0) (< k (vector-length gv)))
      (vector-ref gv k)
      #f)))

(define (daed:evo-restore-good! ckt r k)
  (let ((g (daed:evo-good r k)))
    (if (not g)
      #f
      (daed:restore-circuit! ckt (hash-ref g "snap" #f)))))

(define (daed:evo-replay! ckt lg)
  (if (not lg)
    0
    (let ((n (vector-length lg))
          (i 0)
          (k 0))
      (while (lambda () (< i n))
        (lambda ()
          (let ((e (vector-ref lg i)))
            (if (and e (equal? (hash-ref e "decision" "") "commit"))
              (begin
                (daed:mutate-value! ckt
                                    (hash-ref e "name" "")
                                    (hash-ref e "new" 0.0))
                (set! k (+ k 1)))
              0))
          (set! i (+ i 1))))
      k)))

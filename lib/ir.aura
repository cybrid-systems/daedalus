; lib/ir.aura — Schematic IR + conversion (issue #6 / #7)
;
; (require "ir" all:)
;
; Hash-based daedalus-ir/1. Pure Aura.
; VLM JSON is ingested with json-parse + daed:ir-ingest (generic, tolerant).

(export daed:ir-version
        daed:ir-schema-id
        daed:str-ends?
        daed:str-drop-end
        daed:parse-value
        daed:node-id
        daed:ir-new
        daed:ir-comp
        daed:ir-comp3
        daed:ir-add-comp!
        daed:ir-title
        daed:ir-gnd
        daed:ir-comps
        daed:ir->circuit
        daed:circuit->ir
        daed:ir-ingest
        daed:ir-load
        daed:ir-ex-divider
        daed:ir-ex-rc
        daed:ir-ex-series-r
        daed:ir-ex-norton
        daed:ir-ex-diode)

(require "netlist" all:)

(define daed:ir-version 1)
(define daed:ir-schema-id "daedalus-ir/1")

(define (daed:str-ends? s suf)
  (if (or (not (string? s)) (not (string? suf)))
    #f
    (let ((n (string-length s))
          (m (string-length suf)))
      (if (< n m)
        #f
        (equal? (substring s (- n m) n) suf)))))

(define (daed:str-drop-end s n)
  (if (or (not (string? s)) (not (number? n)) (< n 0))
    s
    (let ((len (string-length s)))
      (if (>= n len)
        ""
        (substring s 0 (- len n))))))

; Engineering value: number, or string "2.2k", "1uF", "5V".
; Numeric run is taken from the start; the rest is SI prefix + unit.
(define (daed:parse-value v)
  (if (number? v)
    v
    (if (not (string? v))
      #f
      (daed:parse-value-str v))))

(define (daed:num-char? ch)
  (or (equal? ch "0") (equal? ch "1") (equal? ch "2") (equal? ch "3")
      (equal? ch "4") (equal? ch "5") (equal? ch "6") (equal? ch "7")
      (equal? ch "8") (equal? ch "9") (equal? ch ".") (equal? ch "-")
      (equal? ch "+") (equal? ch "e") (equal? ch "E")))

(define (daed:str-starts? s pre)
  (if (or (not (string? s)) (not (string? pre)))
    #f
    (let ((n (string-length s))
          (m (string-length pre)))
      (if (< n m)
        #f
        (equal? (substring s 0 m) pre)))))

(define (daed:si-scale suf)
  (if (or (daed:str-starts? suf "Meg") (daed:str-starts? suf "meg"))
    1e6
    (if (or (daed:str-starts? suf "k") (daed:str-starts? suf "K"))
      1e3
      (if (daed:str-starts? suf "M")
        1e6
        (if (daed:str-starts? suf "m")
          1e-3
          (if (or (daed:str-starts? suf "u") (daed:str-starts? suf "µ"))
            1e-6
            (if (daed:str-starts? suf "n")
              1e-9
              (if (daed:str-starts? suf "p")
                1e-12
                1.0))))))))

(define (daed:parse-value-str s)
  (let ((n (string-length s))
        (i 0)
        (head "")
        (tail "")
        (num #f))
    (while (lambda () (and (< i n) (daed:num-char? (substring s i (+ i 1)))))
      (lambda () (set! i (+ i 1))))
    (if (= i 0)
      #f
      (begin
        (set! head (substring s 0 i))
        (set! tail (if (< i n) (substring s i n) ""))
        (set! num (string->number head))
        (if (number? num)
          (* num (daed:si-scale tail))
          #f)))))

; Map extractor node tokens to integer ids. GND/gnd/0 → 0.
(define (daed:node-id x)
  (if (number? x)
    (inexact->exact (round x))
    (if (not (string? x))
      -1
      (if (or (equal? x "0") (equal? x "GND") (equal? x "gnd")
              (equal? x "Gnd") (equal? x "ground"))
        0
        (let ((n (string->number x)))
          (if (number? n)
            (inexact->exact (round n))
            -1))))))

(define (daed:ir-new title)
  (let ((h (hash)))
    (hash-set! h "schema" daed:ir-schema-id)
    (hash-set! h "title" (if (string? title) title "ckt"))
    (hash-set! h "gnd" 0)
    (hash-set! h "comps" '())
    (hash-set! h "notes" "")
    h))

(define (daed:ir-comp type name n1 n2 value)
  (let ((h (hash)))
    (hash-set! h "type" type)
    (hash-set! h "name" name)
    (hash-set! h "n1" n1)
    (hash-set! h "n2" n2)
    (hash-set! h "value" value)
    h))

(define (daed:ir-comp3 type name n1 n2 n3 value)
  (let ((h (daed:ir-comp type name n1 n2 value)))
    (hash-set! h "n3" n3)
    h))

(define (daed:ir-add-comp! ir c)
  (hash-set! ir "comps" (cons c (hash-ref ir "comps" '())))
  ir)

(define (daed:ir-title ir)
  (hash-ref ir "title" "ckt"))

(define (daed:ir-gnd ir)
  (daed:node-id (hash-ref ir "gnd" 0)))

(define (daed:ir-comps ir)
  (hash-ref ir "comps" '()))

(define (daed:ir-known-type? ty)
  (or (equal? ty "R") (equal? ty "C") (equal? ty "L")
      (equal? ty "V") (equal? ty "I") (equal? ty "D") (equal? ty "Q")
      (equal? ty "M")
      (equal? ty "E") (equal? ty "G") (equal? ty "F") (equal? ty "H")))

(define (daed:ir-comp->comp c)
  (let ((ty (hash-ref c "type" ""))
        (nm (hash-ref c "name" ""))
        (n1 (daed:node-id (hash-ref c "n1" 0)))
        (n2 (daed:node-id (hash-ref c "n2" 0)))
        (n3 (daed:node-id (hash-ref c "n3" 0)))
        (val (daed:parse-value (hash-ref c "value" 0)))
        (params (hash-ref c "params" #f)))
    (if (not (number? val))
      (set! val 0)
      0)
    (let ((out #f))
      (cond
        ((equal? ty "R") (set! out (daed:R nm n1 n2 val)))
        ((equal? ty "C") (set! out (daed:C nm n1 n2 val)))
        ((equal? ty "L") (set! out (daed:L nm n1 n2 val)))
        ((equal? ty "V") (set! out (daed:V nm n1 n2 val)))
        ((equal? ty "I") (set! out (daed:I nm n1 n2 val)))
        ((equal? ty "D") (set! out (daed:D* nm n1 n2
                                           (if (and (> val 0.0) (< val 1e-6)) val 1e-14)
                                           1.0 0.026)))
        ((equal? ty "Q") (set! out (daed:Q* nm n1 n2 n3
                                           (if (and (> val 0.0) (< val 1e-6)) val 1e-15)
                                           100.0 1.0 0.026)))
        ((equal? ty "M") (set! out (daed:M* nm n1 n2 n3
                                           (if (> val 0.0) val 2e-4)
                                           20e-6 2e-6 0.8)))
        ((equal? ty "E")
         (set! out (daed:E nm n1 n2 n3
                           (daed:node-id (hash-ref c "n4" 0)) val)))
        ((equal? ty "G")
         (set! out (daed:G nm n1 n2 n3
                           (daed:node-id (hash-ref c "n4" 0)) val)))
        ((equal? ty "F")
         (set! out (daed:F nm n1 n2 (hash-ref c "ctrl" "") val)))
        ((equal? ty "H")
         (set! out (daed:H nm n1 n2 (hash-ref c "ctrl" "") val)))
        (else (set! out #f)))
      (if (and out params)
        (begin
          (if (hash-ref params "n" #f)
            (hash-set! out "n" (hash-ref params "n" 1.0))
            0)
          (if (hash-ref params "vt" #f)
            (hash-set! out "vt" (hash-ref params "vt" 0.026))
            0)
          (if (hash-ref params "bf" #f)
            (hash-set! out "bf" (hash-ref params "bf" 100.0))
            0)
          (if (hash-ref params "br" #f)
            (hash-set! out "br" (hash-ref params "br" 1.0))
            0)
          (if (hash-ref params "gmin" #f)
            (hash-set! out "gmin" (hash-ref params "gmin" 1e-12))
            0)
          (if (hash-ref params "vto" #f)
            (hash-set! out "vto" (hash-ref params "vto" 0.8))
            0)
          (if (hash-ref params "w" #f)
            (hash-set! out "w" (hash-ref params "w" 20e-6))
            0)
          (if (hash-ref params "l" #f)
            (hash-set! out "l" (hash-ref params "l" 2e-6))
            0)
          (if (hash-ref params "lambda" #f)
            (hash-set! out "lambda" (hash-ref params "lambda" 0.0))
            0)
          (if (hash-ref params "Is" #f)
            (hash-set! out "value" (hash-ref params "Is" val))
            0))
        0)
      out)))

; ── Ingest VLM / file / hash JSON into a clean IR ──

(define (daed:ir-str-has? s sub)
  (if (or (not (string? s)) (not (string? sub)))
    #f
    (let ((n (string-length s))
          (m (string-length sub))
          (found #f)
          (i 0))
      (if (> m n)
        #f
        (begin
          (while (lambda () (and (not found) (<= i (- n m))))
            (lambda ()
              (if (equal? (substring s i (+ i m)) sub)
                (set! found #t)
                0)
              (set! i (+ i 1))))
          found)))))

(define (daed:ir-mem-num? x xs)
  (if (null? xs)
    #f
    (if (equal? x (car xs))
      #t
      (daed:ir-mem-num? x (cdr xs)))))

(define (daed:ir-type-alias ty)
  (if (or (equal? ty "R") (equal? ty "r") (equal? ty "RESISTOR") (equal? ty "resistor"))
    "R"
    (if (or (equal? ty "C") (equal? ty "c") (equal? ty "CAPACITOR") (equal? ty "capacitor"))
      "C"
      (if (or (equal? ty "L") (equal? ty "l") (equal? ty "INDUCTOR") (equal? ty "inductor"))
        "L"
        (if (or (equal? ty "V") (equal? ty "v") (equal? ty "VOLTAGE") (equal? ty "voltage")
                (equal? ty "BATTERY") (equal? ty "battery") (equal? ty "BT") (equal? ty "bt"))
          "V"
          (if (or (equal? ty "I") (equal? ty "i") (equal? ty "CURRENT") (equal? ty "current"))
            "I"
            (if (or (equal? ty "D") (equal? ty "d") (equal? ty "DIODE") (equal? ty "diode")
                    (equal? ty "LED") (equal? ty "led"))
              "D"
              (if (or (equal? ty "Q") (equal? ty "q") (equal? ty "TRANSISTOR") (equal? ty "transistor")
                      (equal? ty "NPN") (equal? ty "npn") (equal? ty "PNP") (equal? ty "pnp")
                      (equal? ty "BJT") (equal? ty "bjt") (equal? ty "9013") (equal? ty "9014"))
                "Q"
                (if (or (equal? ty "M") (equal? ty "m") (equal? ty "MOSFET") (equal? ty "nmos"))
                  "M"
                  ty)))))))))

(define (daed:ir-blob c)
  (string-append
    (if (string? (hash-ref c "name" #f)) (hash-ref c "name") "")
    " "
    (if (string? (hash-ref c "type" #f)) (hash-ref c "type") "")
    " "
    (if (string? (hash-ref c "value" #f)) (hash-ref c "value") "")
    " "
    (if (string? (hash-ref c "model" #f)) (hash-ref c "model") "")))

(define (daed:ir-looks-led? c)
  (let ((b (daed:ir-blob c)))
    (or (daed:ir-str-has? b "LED") (daed:ir-str-has? b "led")
        (daed:ir-str-has? b "发光"))))

(define (daed:ir-looks-bjt? c)
  (let ((b (daed:ir-blob c)))
    (or (daed:ir-str-has? b "9013") (daed:ir-str-has? b "9014")
        (daed:ir-str-has? b "9012") (daed:ir-str-has? b "8050")
        (daed:ir-str-has? b "2N3904") (daed:ir-str-has? b "2n3904")
        (daed:ir-str-has? b "2N2222"))))

(define (daed:ir-tiny-is? v)
  (let ((n (daed:parse-value v)))
    (and (number? n) (> n 0.0) (< n 1e-6))))

(define (daed:ir-copy-params src)
  (let ((p (hash))
        (s (hash-ref src "params" #f)))
    (if s
      (begin
        (if (hash-ref s "Is" #f) (hash-set! p "Is" (hash-ref s "Is")) 0)
        (if (hash-ref s "n" #f) (hash-set! p "n" (hash-ref s "n")) 0)
        (if (hash-ref s "vt" #f) (hash-set! p "vt" (hash-ref s "vt")) 0)
        (if (hash-ref s "bf" #f) (hash-set! p "bf" (hash-ref s "bf")) 0)
        (if (hash-ref s "br" #f) (hash-set! p "br" (hash-ref s "br")) 0)
        (if (hash-ref s "gmin" #f) (hash-set! p "gmin" (hash-ref s "gmin")) 0)
        p)
      p)))

(define (daed:ir-comp-ingest raw)
  (if (not raw)
    #f
    (let ((ty (daed:ir-type-alias (hash-ref raw "type" "")))
          (nm (hash-ref raw "name" #f))
          (val (hash-ref raw "value" ""))
          (c (hash))
          (p (daed:ir-copy-params raw)))
      (if (not (string? nm))
        (set! nm (hash-ref raw "label" #f))
        0)
      (if (or (not (string? nm)) (equal? nm ""))
        #f
        (begin
          (if (or (daed:ir-looks-led? raw) (equal? ty "LED"))
            (set! ty "D")
            0)
          (if (or (and (equal? ty "V") (daed:ir-looks-bjt? raw))
                  (daed:ir-looks-bjt? raw))
            (if (or (equal? ty "V") (equal? ty "X") (equal? ty ""))
              (set! ty "Q")
              0)
            0)
          (if (not (daed:ir-known-type? ty))
            #f
            (begin
              (hash-set! c "type" ty)
              (hash-set! c "name" nm)
              (hash-set! c "n1" (daed:node-id (hash-ref raw "n1" 0)))
              (hash-set! c "n2" (daed:node-id (hash-ref raw "n2" 0)))
              (if (or (equal? ty "Q") (equal? ty "M"))
                (hash-set! c "n3" (daed:node-id (hash-ref raw "n3" (hash-ref raw "ne" 0))))
                0)
              (if (equal? ty "Q")
                (begin
                  (if (not (number? (hash-ref p "Is" #f)))
                    (if (daed:ir-tiny-is? val)
                      (hash-set! p "Is" (daed:parse-value val))
                      (hash-set! p "Is" 1e-15))
                    0)
                  (if (daed:ir-tiny-is? val)
                    (set! val (if (daed:ir-looks-bjt? raw) "9013" "NPN"))
                    0)
                  (if (and (number? val) (>= val 100.0))
                    (set! val (number->string (inexact->exact (round val))))
                    0)
                  (hash-set! c "params" p))
                0)
              (if (equal? ty "D")
                (begin
                  (if (not (number? (hash-ref p "Is" #f)))
                    (if (daed:ir-tiny-is? val)
                      (hash-set! p "Is" (daed:parse-value val))
                      (hash-set! p "Is" 1e-14))
                    0)
                  (if (daed:ir-tiny-is? val)
                    0
                    0)
                  (hash-set! c "params" p))
                0)
              (hash-set! c "value" val)
              c)))))))

(define (daed:ir-untie-emitters! comps)
  (let ((bases '()))
    (let loop ((cs comps))
      (if (null? cs)
        0
        (begin
          (if (equal? (hash-ref (car cs) "type" "") "Q")
            (set! bases (cons (hash-ref (car cs) "n2" -1) bases))
            0)
          (loop (cdr cs)))))
    (let loop2 ((cs comps))
      (if (null? cs)
        comps
        (begin
          (if (equal? (hash-ref (car cs) "type" "") "Q")
            (let ((e (hash-ref (car cs) "n3" 0)))
              (if (and (number? e) (not (= e 0)) (daed:ir-mem-num? e bases))
                (hash-set! (car cs) "n3" 0)
                0))
            0)
          (loop2 (cdr cs)))))))

(define (daed:ir-read-src src)
  (if (not (string? src))
    src
    (if (file-exists? src)
      (json-parse (read-file src))
      (json-parse src))))

(define (daed:ir-ingest src)
  (let ((obj (daed:ir-read-src src)))
    (if (not obj)
      #f
      (let ((ir (daed:ir-new (hash-ref obj "title" "extracted")))
            (acc '())
            (cs (hash-ref obj "comps" '())))
        (hash-set! ir "schema" daed:ir-schema-id)
        (hash-set! ir "gnd" (daed:node-id (hash-ref obj "gnd" 0)))
        (if (string? (hash-ref obj "notes" #f))
          (hash-set! ir "notes" (hash-ref obj "notes"))
          0)
        (if (hash-ref obj "source" #f)
          (hash-set! ir "source" (hash-ref obj "source"))
          0)
        (if (not (list? cs))
          (set! cs '())
          0)
        (let loop ((xs cs))
          (if (null? xs)
            0
            (begin
              (let ((c (daed:ir-comp-ingest (car xs))))
                (if c
                  (set! acc (cons c acc))
                  0))
              (loop (cdr xs)))))
        (set! acc (reverse acc))
        (daed:ir-untie-emitters! acc)
        (hash-set! ir "comps" acc)
        ir))))

(define (daed:ir-load path)
  (daed:ir-ingest path))

; Reverse comps so ir-add-comp! cons-order still converts in source order
; when the caller used ir-add-comp!. List literals stay as written.
(define (daed:ir-comp-list ir)
  (hash-ref ir "comps" '()))

(define (daed:ir->circuit ir)
  (let ((title (daed:ir-title ir))
        (acc '()))
    (let loop ((cs (daed:ir-comp-list ir)))
      (if (null? cs)
        (daed:circuit title (reverse acc))
        (begin
          (let ((c (daed:ir-comp->comp (car cs))))
            (if c
              (set! acc (cons c acc))
              0))
          (loop (cdr cs)))))))

(define (daed:circuit->ir ckt)
  (let ((ir (daed:ir-new (daed:ckt-name ckt)))
        (acc '()))
    (let loop ((cs (daed:ckt-comps ckt)))
      (if (null? cs)
        (begin
          (hash-set! ir "comps" (reverse acc))
          ir)
        (begin
          (let ((c (car cs)))
            (let ((h (daed:ir-comp (daed:comp-type c)
                                   (daed:comp-name c)
                                   (daed:comp-n1 c)
                                   (daed:comp-n2 c)
                                   (daed:comp-value c))))
              (if (or (equal? (daed:comp-type c) "Q")
                      (equal? (daed:comp-type c) "M"))
                (hash-set! h "n3" (daed:comp-n3 c))
                0)
              (if (or (equal? (daed:comp-type c) "E")
                      (equal? (daed:comp-type c) "G"))
                (begin
                  (hash-set! h "n3" (daed:comp-n3 c))
                  (hash-set! h "n4" (daed:comp-n4 c)))
                0)
              (if (or (equal? (daed:comp-type c) "F")
                      (equal? (daed:comp-type c) "H"))
                (hash-set! h "ctrl" (daed:comp-ctrl c))
                0)
              (set! acc (cons h acc))))
          (loop (cdr cs)))))))

; ── Canonical examples (hand-written IR) ──

(define (daed:ir-ex-divider)
  (let ((ir (daed:ir-new "divider")))
    (hash-set! ir "comps"
      (list (daed:ir-comp "V" "vin" 1 0 5.0)
            (daed:ir-comp "R" "r1" 1 2 "1k")
            (daed:ir-comp "R" "r2" 2 0 "2k")))
    ir))

(define (daed:ir-ex-rc)
  (let ((ir (daed:ir-new "rc-lp")))
    (hash-set! ir "comps"
      (list (daed:ir-comp "V" "vin" 1 0 5.0)
            (daed:ir-comp "R" "r1" 1 2 "1kΩ")
            (daed:ir-comp "C" "c1" 2 0 "1uF")))
    ir))

(define (daed:ir-ex-series-r)
  (let ((ir (daed:ir-new "series-r")))
    (hash-set! ir "comps"
      (list (daed:ir-comp "V" "vin" 1 0 5.0)
            (daed:ir-comp "R" "r1" 1 0 1e3)))
    ir))

(define (daed:ir-ex-norton)
  (let ((ir (daed:ir-new "norton")))
    (hash-set! ir "comps"
      (list (daed:ir-comp "I" "iin" 0 1 0.001)
            (daed:ir-comp "R" "r1" 1 0 "2k")))
    ir))

(define (daed:ir-ex-diode)
  (let ((ir (daed:ir-new "diode-fwd")))
    (hash-set! ir "comps"
      (list (daed:ir-comp "V" "vin" 1 0 5.0)
            (daed:ir-comp "R" "r1" 1 2 "1k")
            (daed:ir-comp "D" "d1" 2 0 1e-14)))
    ir))

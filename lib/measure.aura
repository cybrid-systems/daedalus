; lib/measure.aura — .measure + waveform export (issue #20 / M2)
;
; (require "measure" all:)
;
; Query MAX/MIN/AVG/RMS, WHEN crossings, TRIG/TARG delay / rise-time
; on a .tran result. CSV export for plotters / Aether.
; Trapezoidal integrals so adaptive dt is valid. Pure Aura.

(export daed:measure-version
        daed:meas-ok?
        daed:meas-value
        daed:meas-t
        daed:meas-t2
        daed:meas-kind
        daed:measure-max
        daed:measure-min
        daed:measure-avg
        daed:measure-rms
        daed:measure-final
        daed:measure-when
        daed:measure-delay
        daed:measure-risetime
        daed:measure-summary
        daed:tran->csv
        daed:write-tran-csv!)

(require "tran" all:)

(define daed:measure-version 1)

(define (daed:meas-fail kind node)
  (let ((h (hash)))
    (hash-set! h "ok" #f)
    (hash-set! h "kind" kind)
    (hash-set! h "node" node)
    (hash-set! h "value" 0.0)
    (hash-set! h "t" -1.0)
    (hash-set! h "t2" -1.0)
    h))

(define (daed:meas-ok? m)
  (hash-ref m "ok" #f))

(define (daed:meas-value m)
  (hash-ref m "value" 0.0))

(define (daed:meas-t m)
  (hash-ref m "t" -1.0))

(define (daed:meas-t2 m)
  (hash-ref m "t2" -1.0))

(define (daed:meas-kind m)
  (hash-ref m "kind" ""))

(define (daed:wf-n times wv)
  (let ((n (vector-length times))
        (m (vector-length wv)))
    (if (< m n) m n)))

; First rising cross of thresh at or after tmin. -1.0 if none.
(define (daed:cross-rise times wv thresh tmin)
  (let ((n (daed:wf-n times wv))
        (i 0)
        (found #f)
        (out -1.0))
    (while (lambda () (and (not found) (< i (- n 1))))
      (lambda ()
        (let ((t0 (vector-ref times i))
              (t1 (vector-ref times (+ i 1)))
              (v0 (vector-ref wv i))
              (v1 (vector-ref wv (+ i 1))))
          (if (and (>= t1 tmin) (< v0 thresh) (>= v1 thresh))
            (begin
              (set! found #t)
              (let ((dv (- v1 v0)))
                (if (<= (abs dv) 0.0)
                  (set! out t1)
                  (set! out (+ t0 (* (- t1 t0) (/ (- thresh v0) dv)))))))
            (set! i (+ i 1))))))
    out))

(define (daed:trap-int times wv)
  (let ((n (daed:wf-n times wv))
        (s 0.0)
        (i 0))
    (while (lambda () (< i (- n 1)))
      (lambda ()
        (let ((dt (- (vector-ref times (+ i 1)) (vector-ref times i)))
              (a (vector-ref wv i))
              (b (vector-ref wv (+ i 1))))
          (if (> dt 0.0)
            (set! s (+ s (* 0.5 (* dt (+ a b)))))
            0))
        (set! i (+ i 1))))
    s))

(define (daed:trap-int-sq times wv)
  (let ((n (daed:wf-n times wv))
        (s 0.0)
        (i 0))
    (while (lambda () (< i (- n 1)))
      (lambda ()
        (let ((dt (- (vector-ref times (+ i 1)) (vector-ref times i)))
              (a (vector-ref wv i))
              (b (vector-ref wv (+ i 1))))
          (if (> dt 0.0)
            (set! s (+ s (* 0.5 (* dt (+ (* a a) (* b b))))))
            0))
        (set! i (+ i 1))))
    s))

(define (daed:measure-max tr node)
  (let ((times (daed:tran-times tr))
        (wv (daed:tran-series tr node)))
    (let ((n (daed:wf-n times wv)))
      (if (<= n 0)
        (daed:meas-fail "max" node)
        (let ((best (vector-ref wv 0))
              (tb (vector-ref times 0))
              (i 1)
              (h (hash)))
          (while (lambda () (< i n))
            (lambda ()
              (let ((x (vector-ref wv i)))
                (if (> x best)
                  (begin
                    (set! best x)
                    (set! tb (vector-ref times i)))
                  0))
              (set! i (+ i 1))))
          (hash-set! h "ok" #t)
          (hash-set! h "kind" "max")
          (hash-set! h "node" node)
          (hash-set! h "value" best)
          (hash-set! h "t" tb)
          (hash-set! h "t2" tb)
          h)))))

(define (daed:measure-min tr node)
  (let ((times (daed:tran-times tr))
        (wv (daed:tran-series tr node)))
    (let ((n (daed:wf-n times wv)))
      (if (<= n 0)
        (daed:meas-fail "min" node)
        (let ((best (vector-ref wv 0))
              (tb (vector-ref times 0))
              (i 1)
              (h (hash)))
          (while (lambda () (< i n))
            (lambda ()
              (let ((x (vector-ref wv i)))
                (if (< x best)
                  (begin
                    (set! best x)
                    (set! tb (vector-ref times i)))
                  0))
              (set! i (+ i 1))))
          (hash-set! h "ok" #t)
          (hash-set! h "kind" "min")
          (hash-set! h "node" node)
          (hash-set! h "value" best)
          (hash-set! h "t" tb)
          (hash-set! h "t2" tb)
          h)))))

(define (daed:measure-avg tr node)
  (let ((times (daed:tran-times tr))
        (wv (daed:tran-series tr node)))
    (let ((n (daed:wf-n times wv)))
      (if (< n 2)
        (daed:meas-fail "avg" node)
        (let ((T (- (vector-ref times (- n 1)) (vector-ref times 0)))
              (h (hash)))
          (if (<= T 0.0)
            (daed:meas-fail "avg" node)
            (begin
              (hash-set! h "ok" #t)
              (hash-set! h "kind" "avg")
              (hash-set! h "node" node)
              (hash-set! h "value" (/ (daed:trap-int times wv) T))
              (hash-set! h "t" (vector-ref times 0))
              (hash-set! h "t2" (vector-ref times (- n 1)))
              h)))))))

(define (daed:measure-rms tr node)
  (let ((times (daed:tran-times tr))
        (wv (daed:tran-series tr node)))
    (let ((n (daed:wf-n times wv)))
      (if (< n 2)
        (daed:meas-fail "rms" node)
        (let ((T (- (vector-ref times (- n 1)) (vector-ref times 0)))
              (h (hash)))
          (if (<= T 0.0)
            (daed:meas-fail "rms" node)
            (begin
              (hash-set! h "ok" #t)
              (hash-set! h "kind" "rms")
              (hash-set! h "node" node)
              (hash-set! h "value" (sqrt (/ (daed:trap-int-sq times wv) T)))
              (hash-set! h "t" (vector-ref times 0))
              (hash-set! h "t2" (vector-ref times (- n 1)))
              h)))))))

(define (daed:measure-final tr node)
  (let ((times (daed:tran-times tr))
        (wv (daed:tran-series tr node)))
    (let ((n (daed:wf-n times wv)))
      (if (<= n 0)
        (daed:meas-fail "final" node)
        (let ((h (hash)))
          (hash-set! h "ok" #t)
          (hash-set! h "kind" "final")
          (hash-set! h "node" node)
          (hash-set! h "value" (vector-ref wv (- n 1)))
          (hash-set! h "t" (vector-ref times (- n 1)))
          (hash-set! h "t2" (vector-ref times (- n 1)))
          h)))))

; First rising crossing of thresh.
(define (daed:measure-when tr node thresh)
  (let ((times (daed:tran-times tr))
        (wv (daed:tran-series tr node)))
    (let ((n (daed:wf-n times wv)))
      (if (< n 2)
        (daed:meas-fail "when" node)
        (let ((tc (daed:cross-rise times wv thresh (vector-ref times 0)))
              (h (hash)))
          (if (< tc 0.0)
            (daed:meas-fail "when" node)
            (begin
              (hash-set! h "ok" #t)
              (hash-set! h "kind" "when")
              (hash-set! h "node" node)
              (hash-set! h "value" thresh)
              (hash-set! h "t" tc)
              (hash-set! h "t2" tc)
              h)))))))

; TRIG/TARG: rising cross vtrig then rising cross vtarg. value = delay.
(define (daed:measure-delay tr node vtrig vtarg)
  (let ((times (daed:tran-times tr))
        (wv (daed:tran-series tr node)))
    (let ((n (daed:wf-n times wv)))
      (if (< n 2)
        (daed:meas-fail "delay" node)
        (let ((t1 (daed:cross-rise times wv vtrig (vector-ref times 0))))
          (if (< t1 0.0)
            (daed:meas-fail "delay" node)
            (let ((t2 (daed:cross-rise times wv vtarg t1)))
              (if (< t2 0.0)
                (daed:meas-fail "delay" node)
                (let ((h (hash)))
                  (hash-set! h "ok" #t)
                  (hash-set! h "kind" "delay")
                  (hash-set! h "node" node)
                  (hash-set! h "value" (- t2 t1))
                  (hash-set! h "t" t1)
                  (hash-set! h "t2" t2)
                  h)))))))))

; 10 % → 90 % of final sample (RC rise time).
(define (daed:measure-risetime tr node)
  (let ((fin (daed:measure-final tr node)))
    (if (not (daed:meas-ok? fin))
      (daed:meas-fail "risetime" node)
      (let ((vf (daed:meas-value fin)))
        (if (<= (abs vf) 0.0)
          (daed:meas-fail "risetime" node)
          (let ((m (daed:measure-delay tr node (* 0.1 vf) (* 0.9 vf))))
            (hash-set! m "kind" "risetime")
            m))))))

; Agent-facing bundle.
(define (daed:measure-summary tr node)
  (let ((h (hash))
        (mx (daed:measure-max tr node))
        (mn (daed:measure-min tr node))
        (av (daed:measure-avg tr node))
        (rm (daed:measure-rms tr node))
        (fn (daed:measure-final tr node))
        (rt (daed:measure-risetime tr node)))
    (hash-set! h "ok" (and (daed:meas-ok? mx) (daed:meas-ok? fn)))
    (hash-set! h "node" node)
    (hash-set! h "max" (daed:meas-value mx))
    (hash-set! h "min" (daed:meas-value mn))
    (hash-set! h "avg" (daed:meas-value av))
    (hash-set! h "rms" (daed:meas-value rm))
    (hash-set! h "final" (daed:meas-value fn))
    (hash-set! h "tmax" (daed:meas-t mx))
    (hash-set! h "trise" (daed:meas-value rt))
    h))

(define (daed:tran->csv tr)
  (let ((times (daed:tran-times tr))
        (n-v (hash-ref tr "n_v" 0))
        (n 0)
        (hdr "t")
        (body "")
        (k 1)
        (i 0))
    (set! n (vector-length times))
    (while (lambda () (<= k n-v))
      (lambda ()
        (set! hdr (string-append hdr ",v" (number->string k)))
        (set! k (+ k 1))))
    (while (lambda () (< i n))
      (lambda ()
        (let ((line (number->string (vector-ref times i)))
              (j 1))
          (while (lambda () (<= j n-v))
            (lambda ()
              (set! line (string-append line ","
                            (number->string (daed:tran-v-at tr j i))))
              (set! j (+ j 1))))
          (set! body (string-append body line "\n")))
        (set! i (+ i 1))))
    (string-append hdr "\n" body)))

(define (daed:write-tran-csv! tr path)
  (write-file path (daed:tran->csv tr)))

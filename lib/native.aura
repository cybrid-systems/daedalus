; lib/native.aura — C++ dense-solve escape (issue #28 / #30 / M5)
;
; (require "native" all:)
;
; Hephaestus-pattern rebind: logical kernel daed:dense-solve! is
; "pure" (default) or "native". Native path is ffi.aura (c-load +
; one daed_dispatch c-func) + copy-in/out Opaque buffers (issue #32).
; Each native call is a metered escape.
; Failure of bind or solve leaves the Aura matrix untouched.

(export daed:native-version
        daed:native-ready?
        daed:native-lib
        daed:solve-backend
        daed:solve-rebind!
        daed:solve-rebind-ok?
        daed:solve-rebind-reason
        daed:solve-rebind-prev
        daed:solve-kernel-name
        daed:with-escape
        daed:rebind-safe
        daed:kernel-snapshot
        daed:kernel-restore!
        daed:own-check
        daed:own-ok?
        daed:native-bound?
        daed:dense-solve-native!
        daed:native-set-fail!
        daed:native-calls
        daed:native-on-escape!
        daed:solve-backend-set!
        daed:load-kernels
        daed:bind-solve-dense
        daed:bind-c-func
        daed:ffi-ok?
        daed:ffi-reason
        daed:ffi-error
        daed:ffi-lib
        daed:ffi-fn)

(require "ffi" all:)

(define daed:native-version 3)

; Logical kernel name (Hephaestus kscale analogue). Backends: "pure" | "native".
(define daed:solve-kernel-name "solve-mna")

(define *daed-solve-backend* "pure")
(define *daed-native-lib* #f)
(define *daed-native-solve* #f)
(define *daed-native-ver* #f)
(define *daed-native-fail* #f)
(define *daed-native-tried* #f)
(define *daed-native-calls* 0)
(define *daed-native-escape-hook* #f)

(define (daed:native-calls)
  *daed-native-calls*)

(define (daed:native-on-escape! fn)
  (set! *daed-native-escape-hook* fn)
  #t)

(define (daed:native-escape! tag)
  (set! *daed-native-calls* (+ 1 *daed-native-calls*))
  (if *daed-native-escape-hook*
    (*daed-native-escape-hook* tag)
    #t))

(define (daed:solve-backend)
  *daed-solve-backend*)

(define (daed:solve-backend-set! k)
  (set! *daed-solve-backend* (if (string? k) k "pure"))
  *daed-solve-backend*)

(define (daed:native-lib)
  *daed-native-lib*)

(define (daed:native-try-path path)
  (let ((ld (daed:load-kernels path))
        (bd #f))
    (if (not (daed:ffi-ok? ld))
      #f
      (begin
        (set! bd (daed:bind-solve-dense (daed:ffi-lib ld)))
        (if (not (daed:ffi-ok? bd))
          #f
          (begin
            (set! *daed-native-lib* (daed:ffi-lib ld))
            (set! *daed-native-solve* (daed:ffi-dispatch))
            *daed-native-solve*))))))

(define (daed:native-bind!)
  (if *daed-native-tried*
    *daed-native-solve*
    (begin
      (set! *daed-native-tried* #t)
      (if (daed:native-try-path #f)
        *daed-native-solve*
        #f))))

(define (daed:native-bound?)
  (if *daed-native-solve*
    #t
    #f))

(define (daed:native-ready?)
  (if *daed-native-solve*
    #t
    (if (daed:native-bind!)
      #t
      #f)))

(define (daed:native-set-fail! on)
  (if (not (daed:native-ready?))
    #f
    (let ((disp *daed-native-solve*))
      (if (not disp)
        #f
        (begin
          (disp 1 (if on 1 0) 0 0)
          #t)))))

; Hephaestus with-escape: note then run thunk. Eval failure → #f.
(define (daed:with-escape reason thunk)
  (daed:native-escape! reason)
  (try (thunk) (catch (e) #f)))

; Copy A,b → Opaque, call C++, copy b back on rc=0.
(define (daed:dense-solve-native! A b n)
  (if (not (daed:native-ready?))
    #f
    (daed:with-escape "daed-solve-dense"
      (lambda ()
        (daed:ffi-ok? (daed:ffi-solve-dense! A b n))))))

; Hephaestus rebind-safe pattern (no heph lib required).
; kind: "pure" | "native"
(define (daed:solve-rebind! kind)
  (let ((res (hash))
        (prev *daed-solve-backend*)
        (want (if (string? kind) kind "pure")))
    (hash-set! res "ok" #f)
    (hash-set! res "prev" prev)
    (hash-set! res "kind" want)
    (hash-set! res "reason" "init")
    (if (equal? want "native")
      (if (not (daed:native-ready?))
        (begin
          (hash-set! res "reason" "no-lib")
          res)
        (begin
          (set! *daed-solve-backend* "native")
          (hash-set! res "ok" #t)
          (hash-set! res "reason" "applied")
          res))
      (begin
        (set! *daed-solve-backend* "pure")
        (daed:native-set-fail! #f)
        (hash-set! res "ok" #t)
        (hash-set! res "reason" "applied")
        res))))

(define (daed:solve-rebind-ok? r)
  (hash-ref r "ok" #f))

(define (daed:solve-rebind-reason r)
  (hash-ref r "reason" ""))

(define (daed:solve-rebind-prev r)
  (hash-ref r "prev" "pure"))

(define (daed:kernel-snapshot)
  (let ((s (hash)))
    (hash-set! s "backend" *daed-solve-backend*)
    s))

(define (daed:kernel-restore! snap)
  (if (not snap)
    #f
    (begin
      (set! *daed-solve-backend* (hash-ref snap "backend" "pure"))
      (if (equal? *daed-solve-backend* "pure")
        (daed:native-set-fail! #f)
        #t)
      *daed-solve-backend*)))

; Hephaestus rebind-safe, circuit-domain (no heph lib / mutate:rebind).
; name: "solve-mna" or "daed:dense-solve!"
; kind: "pure" | "native"
; On bad name/kind or failed switch, restore the backend snapshot.
(define (daed:rebind-safe name kind)
  (let ((res (hash))
        (snap (daed:kernel-snapshot))
        (nm (if (string? name) name ""))
        (want (if (string? kind) kind ""))
        (r #f))
    (hash-set! res "ok" #f)
    (hash-set! res "prev" (hash-ref snap "backend" "pure"))
    (hash-set! res "kind" want)
    (hash-set! res "name" nm)
    (hash-set! res "reason" "init")
    (hash-set! res "snap" snap)
    (if (and (not (equal? nm "solve-mna"))
             (not (equal? nm "daed:dense-solve!")))
      (begin
        (hash-set! res "reason" "bad-kernel")
        res)
      (if (and (not (equal? want "pure"))
               (not (equal? want "native")))
        (begin
          (hash-set! res "reason" "bad-kind")
          res)
        (begin
          (set! r (daed:solve-rebind! want))
          (if (daed:solve-rebind-ok? r)
            (begin
              (hash-set! res "ok" #t)
              (hash-set! res "reason" "applied")
              res)
            (begin
              (daed:kernel-restore! snap)
              (hash-set! res "reason" (daed:solve-rebind-reason r))
              res)))))))

; Circuit-domain ownership: known backend, native only if bound.
; Does not call native-ready? (that would c-load on the pure path).
(define (daed:own-check)
  (let ((res (hash))
        (be *daed-solve-backend*)
        (known #f)
        (ready #t))
    (set! known (or (equal? be "pure") (equal? be "native")))
    (if (equal? be "native")
      (set! ready (daed:native-bound?))
      #t)
    (hash-set! res "backend" be)
    (hash-set! res "ready" ready)
    (hash-set! res "known-backend" known)
    (hash-set! res "ok" (and known ready))
    res))

(define (daed:own-ok? r)
  (hash-ref r "ok" #f))

(daed:ffi-on-call! daed:native-escape!)

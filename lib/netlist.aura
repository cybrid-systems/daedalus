; lib/netlist.aura — Circuit / Node / Component ADT (Phase 1–5)
;
; (require "netlist" all:)
;
; FlatAST-friendly hashes + component lists. Node 0 is GND.
; Components: R, C, L, independent V / I, diode D, BJT Q (NPN),
; controlled sources E (VCVS), G (VCCS), F (CCCS), H (CCVS).

(export daed:netlist-version
        daed:comp
        daed:R
        daed:C
        daed:L
        daed:V
        daed:I
        daed:D
        daed:D*
        daed:Q
        daed:Q*
        daed:E
        daed:G
        daed:F
        daed:H
        daed:circuit
        daed:ckt-name
        daed:ckt-comps
        daed:comp-type
        daed:comp-name
        daed:comp-n1
        daed:comp-n2
        daed:comp-n3
        daed:comp-n4
        daed:comp-nc
        daed:comp-nb
        daed:comp-ne
        daed:comp-nc+
        daed:comp-nc-
        daed:comp-ctrl
        daed:comp-terminals
        daed:comp-value
        daed:comp-set-value!
        daed:comp-set-n1!
        daed:comp-set-n2!
        daed:comp-set-n3!
        daed:comp-set-n4!
        daed:query-comp
        daed:query-by-type
        daed:query-nodes
        daed:query-names
        daed:comp-param
        daed:comp-set-param!
        daed:has-nonlinear?
        daed:max-node
        daed:count-type
        daed:node-index
        daed:n-voltage-unknowns
        daed:node-voltage
        daed:set-node-voltage!
        daed:x-v)

(define daed:netlist-version 4)

; Default Shockley / Ebers-Moll parameters (educational Si).
(define daed:default-is 1e-14)
(define daed:default-n 1.0)
(define daed:default-vt 0.026)
(define daed:default-bf 100.0)
(define daed:default-br 1.0)
(define daed:default-gmin 1e-12)
(define daed:default-q-is 1e-15)

; ── Component constructors ──
; type: "R" | "C" | "L" | "V" | "I" | "D" | "Q" | "E" | "G" | "F" | "H"
; n1, n2: integer node ids (0 = GND)
; Q uses n3 = emitter; n1 = collector, n2 = base
; value: ohms | farads | henries | volts | amps | Is (D/Q)

(define (daed:comp type name n1 n2 value)
  (let ((h (hash)))
    (hash-set! h "type" type)
    (hash-set! h "name" name)
    (hash-set! h "n1" n1)
    (hash-set! h "n2" n2)
    (hash-set! h "value" value)
    h))

(define (daed:R name n1 n2 value)
  (daed:comp "R" name n1 n2 value))

(define (daed:C name n1 n2 value)
  (daed:comp "C" name n1 n2 value))

(define (daed:L name n1 n2 value)
  (daed:comp "L" name n1 n2 value))

(define (daed:V name n1 n2 value)
  (daed:comp "V" name n1 n2 value))

(define (daed:I name n1 n2 value)
  (daed:comp "I" name n1 n2 value))

; Diode: n1 = anode, n2 = cathode. value = Is.
(define (daed:D* name anode cathode is n vt)
  (let ((h (daed:comp "D" name anode cathode is)))
    (hash-set! h "n" n)
    (hash-set! h "vt" vt)
    (hash-set! h "gmin" daed:default-gmin)
    h))

(define (daed:D name anode cathode)
  (daed:D* name anode cathode daed:default-is daed:default-n daed:default-vt))

; NPN BJT: n1 = collector, n2 = base, n3 = emitter. value = Is.
(define (daed:Q* name nc nb ne is bf br vt)
  (let ((h (daed:comp "Q" name nc nb is)))
    (hash-set! h "n3" ne)
    (hash-set! h "bf" bf)
    (hash-set! h "br" br)
    (hash-set! h "vt" vt)
    (hash-set! h "gmin" daed:default-gmin)
    h))

(define (daed:Q name nc nb ne)
  (daed:Q* name nc nb ne daed:default-q-is daed:default-bf daed:default-br daed:default-vt))

; VCVS E: v(n1,n2) = mu * v(nc+,nc-). value = mu.
(define (daed:E name n1 n2 nc+ nc- mu)
  (let ((h (daed:comp "E" name n1 n2 mu)))
    (hash-set! h "n3" nc+)
    (hash-set! h "n4" nc-)
    h))

; VCCS G: i(n1→n2) = gm * v(nc+,nc-). value = gm.
(define (daed:G name n1 n2 nc+ nc- gm)
  (let ((h (daed:comp "G" name n1 n2 gm)))
    (hash-set! h "n3" nc+)
    (hash-set! h "n4" nc-)
    h))

; CCCS F: i(n1→n2) = beta * i(ctrl). ctrl names a V/E/H branch.
(define (daed:F name n1 n2 ctrl beta)
  (let ((h (daed:comp "F" name n1 n2 beta)))
    (hash-set! h "ctrl" ctrl)
    h))

; CCVS H: v(n1,n2) = rm * i(ctrl). ctrl names a V/E/H branch.
(define (daed:H name n1 n2 ctrl rm)
  (let ((h (daed:comp "H" name n1 n2 rm)))
    (hash-set! h "ctrl" ctrl)
    h))

(define (daed:circuit name comps)
  (let ((h (hash)))
    (hash-set! h "name" name)
    (hash-set! h "comps" comps)
    h))

(define (daed:ckt-name ckt)
  (hash-ref ckt "name" ""))

(define (daed:ckt-comps ckt)
  (hash-ref ckt "comps" '()))

(define (daed:comp-type c)
  (hash-ref c "type" ""))

(define (daed:comp-name c)
  (hash-ref c "name" ""))

(define (daed:comp-n1 c)
  (hash-ref c "n1" 0))

(define (daed:comp-n2 c)
  (hash-ref c "n2" 0))

(define (daed:comp-n3 c)
  (hash-ref c "n3" 0))

(define (daed:comp-n4 c)
  (hash-ref c "n4" 0))

(define (daed:comp-ctrl c)
  (hash-ref c "ctrl" ""))

(define (daed:comp-nc c)
  (daed:comp-n1 c))

(define (daed:comp-nb c)
  (daed:comp-n2 c))

(define (daed:comp-ne c)
  (daed:comp-n3 c))

(define (daed:comp-nc+ c)
  (daed:comp-n3 c))

(define (daed:comp-nc- c)
  (daed:comp-n4 c))

(define (daed:comp-set-n4! c n)
  (hash-set! c "n4" n)
  c)

; Terminal node list for inspection / topology.
(define (daed:comp-terminals c)
  (let ((ty (daed:comp-type c))
        (acc (list (daed:comp-n1 c) (daed:comp-n2 c))))
    (if (equal? ty "Q")
      (set! acc (cons (daed:comp-n3 c) acc))
      0)
    (if (or (equal? ty "E") (equal? ty "G"))
      (set! acc (cons (daed:comp-n4 c) (cons (daed:comp-n3 c) acc)))
      0)
    acc))

(define (daed:comp-value c)
  (hash-ref c "value" 0))

(define (daed:comp-set-value! c value)
  (hash-set! c "value" value)
  c)

(define (daed:comp-set-n1! c n)
  (hash-set! c "n1" n)
  c)

(define (daed:comp-set-n2! c n)
  (hash-set! c "n2" n)
  c)

(define (daed:comp-set-n3! c n)
  (hash-set! c "n3" n)
  c)

(define (daed:comp-param c key default)
  (hash-ref c key default))

(define (daed:comp-set-param! c key val)
  (hash-set! c key val)
  c)

(define (daed:has-nonlinear? comps)
  (or (> (daed:count-type comps "D") 0)
      (> (daed:count-type comps "Q") 0)))

; Highest node id appearing in the netlist (includes BJT emitter / E,G sense).
(define (daed:max-node comps)
  (let ((m 0))
    (let loop ((cs comps))
      (if (null? cs)
        m
        (begin
          (let ((c (car cs)))
            (let ((n1 (daed:comp-n1 c))
                  (n2 (daed:comp-n2 c))
                  (n3 (daed:comp-n3 c))
                  (n4 (daed:comp-n4 c)))
              (if (and (number? n1) (> n1 m)) (set! m n1) 0)
              (if (and (number? n2) (> n2 m)) (set! m n2) 0)
              (if (and (number? n3) (> n3 m)) (set! m n3) 0)
              (if (and (number? n4) (> n4 m)) (set! m n4) 0)))
          (loop (cdr cs)))))))

(define (daed:count-type comps type)
  (let ((n 0))
    (let loop ((cs comps))
      (if (null? cs)
        n
        (begin
          (if (equal? (daed:comp-type (car cs)) type)
            (set! n (+ n 1))
            0)
          (loop (cdr cs)))))))

; Map circuit node id → MNA voltage unknown index.
; Node 0 (GND) → -1. Node k>0 → k-1.
(define (daed:node-index node)
  (if (or (not (number? node)) (<= node 0))
    -1
    (- node 1)))

(define (daed:n-voltage-unknowns comps)
  (daed:max-node comps))

; Read / write node voltage in a state vector (index = node id, 0 always 0).
(define (daed:node-voltage vvec node)
  (if (or (not (number? node)) (< node 0))
    0.0
    (if (>= node (vector-length vvec))
      0.0
      (vector-ref vvec node))))

(define (daed:set-node-voltage! vvec node val)
  (if (and (number? node) (> node 0) (< node (vector-length vvec)))
    (vector-set! vvec node val)
    0)
  vvec)

; Node voltage from an MNA unknown vector x (index = node-1). Node 0 → 0.
(define (daed:x-v x node)
  (if (or (not (number? node)) (<= node 0) (not x))
    0.0
    (let ((i (daed:node-index node)))
      (if (or (< i 0) (>= i (vector-length x)))
        0.0
        (vector-ref x i)))))

; ── Query (circuit-domain; host query:* is a different surface) ──

(define (daed:query-comp ckt name)
  (let loop ((cs (daed:ckt-comps ckt)))
    (if (null? cs)
      #f
      (if (equal? (daed:comp-name (car cs)) name)
        (car cs)
        (loop (cdr cs))))))

(define (daed:query-by-type ckt type)
  (let ((acc '()))
    (let loop ((cs (daed:ckt-comps ckt)))
      (if (null? cs)
        (reverse acc)
        (begin
          (if (equal? (daed:comp-type (car cs)) type)
            (set! acc (cons (car cs) acc))
            0)
          (loop (cdr cs)))))))

(define (daed:query-names ckt)
  (let ((acc '()))
    (let loop ((cs (daed:ckt-comps ckt)))
      (if (null? cs)
        (reverse acc)
        (begin
          (set! acc (cons (daed:comp-name (car cs)) acc))
          (loop (cdr cs)))))))

(define (daed:query-nodes ckt)
  (let ((acc '()))
    (let loop ((cs (daed:ckt-comps ckt)))
      (if (null? cs)
        acc
        (begin
          (let ((ts (daed:comp-terminals (car cs))))
            (let tloop ((xs ts))
              (if (null? xs)
                0
                (begin
                  (let ((n (car xs)))
                    (if (and (number? n) (not (daed:mem-num-q? n acc)))
                      (set! acc (cons n acc))
                      0))
                  (tloop (cdr xs))))))
          (loop (cdr cs)))))))

(define (daed:mem-num-q? n xs)
  (let loop ((ys xs))
    (if (null? ys)
      #f
      (if (equal? (car ys) n)
        #t
        (loop (cdr ys))))))

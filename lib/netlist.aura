; lib/netlist.aura — Circuit / Node / Component ADT (Phase 1–2)
;
; (require "netlist" all:)
;
; FlatAST-friendly hashes + component lists. Node 0 is GND.
; Components: R, C, L, independent V / I.

(export daed:netlist-version
        daed:comp
        daed:R
        daed:C
        daed:L
        daed:V
        daed:I
        daed:circuit
        daed:ckt-name
        daed:ckt-comps
        daed:comp-type
        daed:comp-name
        daed:comp-n1
        daed:comp-n2
        daed:comp-value
        daed:comp-set-value!
        daed:max-node
        daed:count-type
        daed:node-index
        daed:n-voltage-unknowns
        daed:node-voltage
        daed:set-node-voltage!)

(define daed:netlist-version 2)

; ── Component constructors ──
; type: "R" | "C" | "L" | "V" | "I"
; n1, n2: integer node ids (0 = GND)
; value: ohms | farads | henries | volts | amps

(define (daed:comp type name n1 n2 value)
  (let ((h (hash)))
    (hash-set! h "type" type)
    (hash-set! h "name" name)
    (hash-set! h "n1" n1)
    (hash-set! h "n2" n2)
    (hash-set! h "value" value)
    h))

(define (daed:R name n1 n2 value)
  (daed:comp "R" name n1 n2 value))

(define (daed:C name n1 n2 value)
  (daed:comp "C" name n1 n2 value))

(define (daed:L name n1 n2 value)
  (daed:comp "L" name n1 n2 value))

(define (daed:V name n1 n2 value)
  (daed:comp "V" name n1 n2 value))

(define (daed:I name n1 n2 value)
  (daed:comp "I" name n1 n2 value))

(define (daed:circuit name comps)
  (let ((h (hash)))
    (hash-set! h "name" name)
    (hash-set! h "comps" comps)
    h))

(define (daed:ckt-name ckt)
  (hash-ref ckt "name" ""))

(define (daed:ckt-comps ckt)
  (hash-ref ckt "comps" '()))

(define (daed:comp-type c)
  (hash-ref c "type" ""))

(define (daed:comp-name c)
  (hash-ref c "name" ""))

(define (daed:comp-n1 c)
  (hash-ref c "n1" 0))

(define (daed:comp-n2 c)
  (hash-ref c "n2" 0))

(define (daed:comp-value c)
  (hash-ref c "value" 0))

(define (daed:comp-set-value! c value)
  (hash-set! c "value" value)
  c)

; Highest node id appearing in the netlist.
(define (daed:max-node comps)
  (let ((m 0))
    (let loop ((cs comps))
      (if (null? cs)
        m
        (begin
          (let ((c (car cs)))
            (let ((n1 (daed:comp-n1 c))
                  (n2 (daed:comp-n2 c)))
              (if (and (number? n1) (> n1 m)) (set! m n1) 0)
              (if (and (number? n2) (> n2 m)) (set! m n2) 0)))
          (loop (cdr cs)))))))

(define (daed:count-type comps type)
  (let ((n 0))
    (let loop ((cs comps))
      (if (null? cs)
        n
        (begin
          (if (equal? (daed:comp-type (car cs)) type)
            (set! n (+ n 1))
            0)
          (loop (cdr cs)))))))

; Map circuit node id → MNA voltage unknown index.
; Node 0 (GND) → -1. Node k>0 → k-1.
(define (daed:node-index node)
  (if (or (not (number? node)) (<= node 0))
    -1
    (- node 1)))

(define (daed:n-voltage-unknowns comps)
  (daed:max-node comps))

; Read / write node voltage in a state vector (index = node id, 0 always 0).
(define (daed:node-voltage vvec node)
  (if (or (not (number? node)) (< node 0))
    0.0
    (if (>= node (vector-length vvec))
      0.0
      (vector-ref vvec node))))

(define (daed:set-node-voltage! vvec node val)
  (if (and (number? node) (> node 0) (< node (vector-length vvec)))
    (vector-set! vvec node val)
    0)
  vvec)

; lib/probe.aura — Result query helpers (Phase 1–2)
;
; (require "probe" all:)

(export daed:probe-version
        daed:v
        daed:i
        daed:v-ground
        daed:check-approx
        daed:check-voltage
        daed:check-rel)

(require "solve" all:)
(require "tran" all:)

(define daed:probe-version 3)

; Node voltage from .op result. Node 0 → 0.0.
; Also accepts a .tran result (final sample) for convenience.
(define (daed:v res node)
  (if (or (not (number? node)) (<= node 0))
    0.0
    (if (hash-ref res "series" #f)
      (daed:tran-v res node)
      (let ((volts (daed:op-voltages res)))
        (hash-ref volts (number->string node) 0.0)))))

; Branch current from .op (named V/E/H/L). 0 if missing.
(define (daed:i res name)
  (daed:op-i res name))

(define (daed:v-ground)
  0.0)

(define (daed:check-approx actual expected tol)
  (and (number? actual)
       (number? expected)
       (number? tol)
       (< (abs (- actual expected)) tol)))

; Relative error |a-e|/max(|e|,floor) < tol
(define (daed:check-rel actual expected tol floor-abs)
  (if (or (not (number? actual)) (not (number? expected)) (not (number? tol)))
    #f
    (let ((den (abs expected)))
      (let ((d (if (> den floor-abs) den floor-abs)))
        (< (/ (abs (- actual expected)) d) tol)))))

(define (daed:check-voltage res node expected tol)
  (daed:check-approx (daed:v res node) expected tol))
